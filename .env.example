# =============================================================================
# purrxy Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All settings have sensible defaults — you can run with zero configuration.
#
# Precedence: CLI args > environment variables > .env file > defaults

# === Model Configuration ===
# Default model: Qwen2.5-Coder-14B-Instruct Q5_K_M
# Why this default? At ~10.5GB, it fits comfortably in 24GB unified RAM on
# Apple Silicon (M4 Pro) with full GPU offload and 8K context, leaving
# headroom for the OS and other apps. Q5_K_M offers near-lossless quality
# for coding tasks while being significantly faster than Q8 or FP16.
MODEL_NAME=Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-14B-Instruct-GGUF/resolve/main/qwen2.5-coder-14b-instruct-q5_k_m.gguf
MODEL_DIR=~/llama.cpp/models

# === llama.cpp Backend ===
# Path to llama.cpp source/build directory
LLAMA_CPP_DIR=~/llama.cpp

# Context window size in tokens. 8192 is comfortable for coding tasks —
# large enough for multi-file context but small enough to keep VRAM usage
# reasonable on 24GB machines.
CONTEXT_SIZE=8192

# Number of parallel request slots. Set to 1 for single-user local use.
# Increase if you want to handle concurrent requests (uses more VRAM).
PARALLEL_SLOTS=1

# Number of model layers to offload to GPU. 99 = offload everything
# (recommended for Apple Silicon where CPU and GPU share unified memory).
GPU_LAYERS=99

# Enable flash attention for faster inference (requires llama.cpp build
# with flash attention support — most recent builds include it).
FLASH_ATTENTION=true

# Host and port for the llama.cpp backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# === purrxy Settings ===
# Port the proxy listens on (Anthropic SDK clients connect here)
PROXY_PORT=5304

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
PROXY_LOG_LEVEL=INFO

# Default model name returned in Anthropic responses when no model mapping
# matches. This is cosmetic — the backend always uses whatever model is loaded.
DEFAULT_MODEL=local-model
